---
import IconArrow from "../assets/icons/IconArrow.astro";
export interface Props {
  href: string;
  textLink: string;
  title: string;
  target?: string;
  classIcon?: string;
  classLink?: string;
}

const { href, textLink, title, target, classIcon, classLink } = Astro.props;
---

<a
  class=`max-2xl:text-base transition-colors links group flex w-max items-center text-lg mt-6 dark:text-black ${classLink}`
  title={title}
  href={href}
  target={target}
  >{textLink}
  <IconArrow class=`w-4 fill-white dark:fill-black ${classIcon}` /></a
>
