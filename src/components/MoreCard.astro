---
export interface Props {
  title?: string;
  href?: string;
  class?: string;
  text?: string;
  colorText: string;
  textColor: string;
}
---

<a
  title={Astro.props.title}
  href={Astro.props.href}
  class=`${Astro.props.class} w-full flex items-start justify-center flex-col rounded-lg border border-zinc-700 p-6 hover:scale-105 transition-all bg-zinc-700 bg-opacity-50 dark:bg-white dark:bg-opacity-30 dark:border-black/10 dark:shadow-md`
>
  <p
    class="text-pretty text-2xl max-2xl:text-[20.5px] text-white dark:text-zinc-800"
  >
    {Astro.props.text}
    <br />
    <span class=`${Astro.props.colorText} font-bold`
      >{Astro.props.textColor}</span
    >
  </p>
</a>
